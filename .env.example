# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===================================================================
# MERN STACK & DYNAMIC CONFIGURATION
# ===================================================================
# Database Connection URL (MongoDB connection string, e.g. mongodb+srv://...)
# If left unset, the backend seamlessly uses optimized fast indexed persistent JSON storage
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority"

# JWT Authentication Secret Key & Expiration
JWT_SECRET="super_secret_jwt_key_ammar_nazir_portfolio_2026_dev"
JWT_EXPIRES_IN="7d"

# Admin Login Credentials for Initial Setup
ADMIN_EMAIL="admin@ammar.dev"
ADMIN_PASSWORD="admin_secure_password"

# WhatsApp Contact Configuration (Country code + Phone number without '+' or special characters, e.g. 923001234567)
WHATSAPP_NUMBER="923001234567"

# Public Resume Google Drive Link
GOOGLE_DRIVE_RESUME_URL="https://drive.google.com/file/d/1Bxxxxxxxxx_ammar_nazir_resume/view?usp=sharing"

# Client Vite API Base URL (empty or relative '/api' when hosted full-stack)
VITE_API_URL="/api"

